SEPOLIA_RPC_URL=

# Required by every ENSv2 script. Never mix profile addresses.
# Allowed: current | explorer-v1-r2
ENSV2_DEPLOYMENT_PROFILE=

# Required for real Sepolia issuance planning / fork simulation (no private keys).
NOMADIC_PARENT_OWNER_ADDRESS=
PASSPORT_OWNER_ADDRESS=
LISBON_HOUSE_ISSUER_ADDRESS=

# Aliases accepted by scripts (optional if the names above are set).
ENSV2_PLATFORM_ADDRESS=
ENSV2_PASSPORT_OWNER_ADDRESS=
ENSV2_ISSUER_ADDRESS=

ENSV2_PARENT_NAME=nomadic-passport.eth
ENSV2_PASSPORT_LABEL=victor
ENSV2_CREDENTIAL_LABEL=lisbon-house

ENSV2_EXPECTED_CHAIN_ID=11155111
ENSV2_BROADCAST=false

# Leave blank until ENS explicitly confirms Explorer-r2 routing stability.
# Broadcast-capable Explorer-r2 scripts require exactly: explorer-v1-r2-confirmed
ENSV2_ROUTING_ACK=

# Optional Magic-bundle override; defaults to the fork/latest block timestamp.
ENSV2_ISSUED_AT=
